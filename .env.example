DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
# Recommended while testing; leave blank for global commands
DISCORD_GUILD_ID=

API_BASE_URL=https://vm.animecloudpanel.indevs.in/api/v1
API_KEY=your_panel_api_key
API_TIMEOUT_MS=15000

# Trusted Discord user IDs; only these IDs bypass VPS_ACCESS_MAP
ADMIN_USER_IDS=123456789012345678
# JSON object mapping Discord user IDs to allowed VPS IDs; default denies non-admins
# Example: {"123456789012345678":["11","12"],"987654321098765432":["15"]}
VPS_ACCESS_MAP={}
ADMIN_LOG_CHANNEL_ID=
API_DOC_PATHS=/openapi.json,/api/openapi.json,/docs,/info,/health

# Panel bridge route relative to API_BASE_URL; see panel-integration/README.md
SSHX_API_PATH_TEMPLATE=integrations/discord/vps/{id}/sshx
SSHX_ALLOWED_HOSTS=sshx.io
