DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_application_id
# Recommended while testing; leave blank for global commands
DISCORD_GUILD_ID=

API_BASE_URL=https://vm.animecloudpanel.indevs.in/api/v1
API_KEY=your_panel_api_key
API_TIMEOUT_MS=15000

# Comma-separated Discord user IDs permitted to use admin commands
ADMIN_USER_IDS=123456789012345678
# Optional audit-log channel
ADMIN_LOG_CHANNEL_ID=
# Optional metadata discovery paths
API_DOC_PATHS=/openapi.json,/api/openapi.json,/docs,/info,/health
